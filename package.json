{
  "name": "enpassant",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Import chess games, explore Stockfish variations, and watch evolution diagrams grow through replay.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=10.33.4 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-engine.mjs",
    "prebuild": "node scripts/prepare-engine.mjs",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "pretest:e2e": "node scripts/prepare-engine.mjs",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@viz-js/viz": "3.30.0",
    "chess.js": "1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "18.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.33.4"
}
